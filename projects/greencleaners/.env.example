# --- Email delivery for the pickup booking form (optional, see app/api/booking/route.ts) ---
# Sign up at https://resend.com, verify your domain, then paste the API key here.
RESEND_API_KEY=

# Where booking requests should be delivered.
BOOKING_TO_EMAIL=greencleanershellas@gmail.com
# The "from" address must be on a domain you verified in Resend.
BOOKING_FROM_EMAIL=Green Cleaners <noreply@greencleaners.gr>

# Public site URL (used for canonical metadata + sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://greencleaners.gr
