---
import type { Product } from '@/lib/products';
interface Props {
  product?: Product | null;
  stock?: Record<string, number>;
  brands: string[];
  categories: { slug: string; label: string }[];
  // [{ value: stored filename-or-URL, preview: displayable URL }] for existing photos
  initImages?: { value: string; preview: string }[];
}
const { product = null, stock = {}, brands, categories, initImages = [] } = Astro.props;
const isNew = !product;
const p = product;
const val = (v: unknown) => (v == null ? '' : String(v));
---

<form
  data-product-form
  data-slug={p?.slug ?? ''}
  data-init-images={JSON.stringify(initImages)}
  class="space-y-7"
>
  <div class="grid gap-7 lg:grid-cols-[1fr_360px]">
    <!-- LEFT: core fields -->
    <div class="space-y-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Name *</span>
          <input name="name" required value={val(p?.name)} class="af-input" placeholder="Nike Dunk Low Grey Fog" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Brand *</span>
          <input name="brand" required list="brand-list" value={val(p?.brand)} class="af-input" placeholder="Nike" />
          <datalist id="brand-list">{brands.map((b) => <option value={b} />)}</datalist>
        </label>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Price (€) *</span>
          <input name="price" type="number" min="0" step="1" required value={val(p?.price)} class="af-input" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Compare-at (€)</span>
          <input name="compareAtPrice" type="number" min="0" step="1" value={val(p?.compareAtPrice)} class="af-input" placeholder="optional" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Primary category</span>
          <select name="category" class="af-input">
            {categories.map((c) => <option value={c.slug} selected={p?.category === c.slug}>{c.label}</option>)}
          </select>
        </label>
      </div>

      <div>
        <span class="mb-1.5 block text-xs font-600 text-faint">Also in categories</span>
        <div class="flex flex-wrap gap-2">
          {categories.map((c) => (
            <label class="cursor-pointer">
              <input type="checkbox" name="categories" value={c.slug} checked={p?.categories?.includes(c.slug)} class="peer sr-only" />
              <span class="inline-block rounded-full border border-line px-3 py-1.5 text-sm text-muted peer-checked:border-accent peer-checked:bg-accent peer-checked:text-on-accent">{c.label}</span>
            </label>
          ))}
        </div>
      </div>

      <label class="block">
        <span class="mb-1.5 block text-xs font-600 text-faint">Sizes (comma separated)</span>
        <input name="sizes" value={(p?.sizes ?? []).join(', ')} class="af-input" placeholder="40, 41, 42, 43, 44" />
      </label>

      <label class="block">
        <span class="mb-1.5 block text-xs font-600 text-faint">Colours (name:hex, comma separated)</span>
        <input name="colors" value={(p?.colors ?? []).map((c) => `${c.name}:${c.hex}`).join(', ')} class="af-input" placeholder="White:#f3f2ee, Grey:#b8b8b8" />
      </label>

      <label class="block">
        <span class="mb-1.5 block text-xs font-600 text-faint">Description</span>
        <textarea name="description" rows="4" class="af-input">{val(p?.description)}</textarea>
      </label>

      <label class="block">
        <span class="mb-1.5 block text-xs font-600 text-faint">Materials</span>
        <input name="materials" value={val(p?.materials)} class="af-input" />
      </label>
    </div>

    <!-- RIGHT: media + meta -->
    <div class="space-y-5">
      <div class="rounded-2xl border border-line p-4">
        <span class="mb-2 block text-xs font-600 text-faint">Photos</span>
        <div data-images class="grid grid-cols-3 gap-2"></div>
        <label class="mt-3 flex cursor-pointer items-center justify-center rounded-xl border border-dashed border-line-strong py-3 text-sm text-muted hover:border-accent hover:text-accent-soft">
          <input data-image-input type="file" accept="image/*" multiple class="hidden" />
          <span data-upload-label>+ Upload photos</span>
        </label>
        <p class="mt-2 text-[11px] text-faint">First photo is the cover. Drag not needed — uploads append; remove with ×.</p>
      </div>

      <div class="grid grid-cols-2 gap-4 rounded-2xl border border-line p-4">
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Badge</span>
          <select name="badge" class="af-input">
            {['', 'new', 'hot', 'limited'].map((b) => <option value={b} selected={(p?.badge ?? '') === b}>{b || 'none'}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Release date</span>
          <input name="releaseDate" type="date" value={val(p?.releaseDate)} class="af-input" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Rating</span>
          <input name="rating" type="number" min="0" max="5" step="0.1" value={val(p?.rating)} class="af-input" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-600 text-faint">Reviews</span>
          <input name="reviews" type="number" min="0" step="1" value={val(p?.reviews ?? 0)} class="af-input" />
        </label>
        <label class="col-span-2 flex items-center gap-2 text-sm text-muted">
          <input type="checkbox" name="inStock" checked={p ? p.inStock : true} class="h-4 w-4 accent-[var(--color-accent)]" /> In stock
        </label>
        <label class="flex items-center gap-2 text-sm text-muted">
          <input type="checkbox" name="featured" checked={!!p?.featured} class="h-4 w-4 accent-[var(--color-accent)]" /> Featured
        </label>
        <label class="flex items-center gap-2 text-sm text-muted">
          <input type="checkbox" name="trending" checked={!!p?.trending} class="h-4 w-4 accent-[var(--color-accent)]" /> Trending
        </label>
      </div>

      <details class="rounded-2xl border border-line p-4">
        <summary class="cursor-pointer text-xs font-600 text-faint">Stock per size (optional)</summary>
        <p class="mt-2 text-[11px] text-faint">Leave empty to keep a size always available. Set 0 to mark sold out.</p>
        <div data-stock-grid class="mt-3 grid grid-cols-3 gap-2" data-initial={JSON.stringify(stock)}></div>
      </details>
    </div>
  </div>

  <!-- Sticky action bar -->
  <div class="sticky bottom-0 -mx-5 flex items-center justify-between gap-3 border-t border-line bg-base/90 px-5 py-4 backdrop-blur-md">
    <div>
      {!isNew && (
        <button type="button" data-delete class="text-sm text-sale hover:underline">Delete product</button>
      )}
    </div>
    <div class="flex items-center gap-3">
      <span data-form-msg class="text-sm"></span>
      <a href="/admin/products" class="btn btn-ghost">Cancel</a>
      <button type="submit" data-save class="btn btn-fill">{isNew ? 'Create product' : 'Save changes'}</button>
    </div>
  </div>
</form>

<style>
  .af-input {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-raised);
    padding: 0.6rem 0.85rem;
    color: var(--color-ink);
    font-size: 0.9rem;
  }
  .af-input:focus { outline: none; border-color: var(--color-accent); }
</style>

<script>
  const form = document.querySelector('[data-product-form]') as HTMLFormElement;
  const slug = form.dataset.slug || '';
  const imagesEl = form.querySelector('[data-images]') as HTMLElement;
  const fileInput = form.querySelector('[data-image-input]') as HTMLInputElement;
  const uploadLabel = form.querySelector('[data-upload-label]') as HTMLElement;
  const stockGrid = form.querySelector('[data-stock-grid]') as HTMLElement;
  const msg = form.querySelector('[data-form-msg]') as HTMLElement;
  const saveBtn = form.querySelector('[data-save]') as HTMLButtonElement;

  // ---- images state: { value (stored), preview (displayable) } ----
  type Img = { value: string; preview: string };
  let images: Img[] = JSON.parse(form.dataset.initImages || '[]');
  function renderImages() {
    imagesEl.innerHTML = images
      .map(
        (img, i) => `
        <div class="relative aspect-square overflow-hidden rounded-lg border ${i === 0 ? 'border-accent' : 'border-line'} bg-white">
          <img src="${img.preview}" class="h-full w-full object-contain p-1" onerror="this.style.opacity=0.2" />
          ${i === 0 ? '<span class="absolute left-1 top-1 rounded bg-accent px-1 text-[9px] font-700 text-on-accent">cover</span>' : ''}
          <button type="button" data-rm="${i}" class="absolute right-1 top-1 flex h-5 w-5 items-center justify-center rounded-full bg-black/60 text-xs text-white">×</button>
        </div>`,
      )
      .join('');
    imagesEl.querySelectorAll('[data-rm]').forEach((b) =>
      b.addEventListener('click', () => { images.splice(Number((b as HTMLElement).dataset.rm), 1); renderImages(); }),
    );
  }

  fileInput.addEventListener('change', async () => {
    if (!fileInput.files?.length) return;
    uploadLabel.textContent = 'Uploading…';
    const fd = new FormData();
    fd.append('slug', (form.querySelector('[name="name"]') as HTMLInputElement)?.value || slug || 'product');
    [...fileInput.files].forEach((f) => fd.append('files', f));
    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      images.push(...data.urls.map((u: string) => ({ value: u, preview: u })));
      renderImages();
    } catch (e: any) {
      msg.textContent = e.message;
      msg.className = 'text-sm text-sale';
    } finally {
      uploadLabel.textContent = '+ Upload photos';
      fileInput.value = '';
    }
  });

  // ---- stock grid (rebuilds from the sizes field) ----
  const initialStock: Record<string, number> = JSON.parse(stockGrid.dataset.initial || '{}');
  function renderStock() {
    const sizes = (form.querySelector('[name="sizes"]') as HTMLInputElement).value
      .split(',').map((s) => s.trim()).filter(Boolean);
    stockGrid.innerHTML = sizes
      .map(
        (s) => `<label class="flex items-center gap-1.5 text-xs text-muted">
          <span class="w-10 shrink-0">${s}</span>
          <input data-stock="${s}" type="number" min="0" value="${initialStock[s] ?? ''}" placeholder="∞" class="af-input !py-1 !px-2 !text-xs" />
        </label>`,
      )
      .join('');
  }
  form.querySelector('[name="sizes"]')?.addEventListener('input', renderStock);

  // ---- collect + submit ----
  function collect() {
    const fd = new FormData(form);
    const sizes = String(fd.get('sizes') || '').split(',').map((s) => s.trim()).filter(Boolean);
    const colors = String(fd.get('colors') || '')
      .split(',').map((c) => c.trim()).filter(Boolean)
      .map((pair) => { const [name, hex] = pair.split(':'); return { name: (name || '').trim(), hex: (hex || '#cccccc').trim() }; });
    const stock: Record<string, number> = {};
    stockGrid.querySelectorAll<HTMLInputElement>('[data-stock]').forEach((i) => {
      if (i.value !== '') stock[i.dataset.stock!] = Number(i.value);
    });
    return {
      slug,
      name: fd.get('name'),
      brand: fd.get('brand'),
      price: Number(fd.get('price')),
      compareAtPrice: fd.get('compareAtPrice') ? Number(fd.get('compareAtPrice')) : null,
      category: fd.get('category'),
      categories: fd.getAll('categories'),
      sizes,
      colors,
      description: fd.get('description'),
      materials: fd.get('materials'),
      badge: fd.get('badge') || null,
      releaseDate: fd.get('releaseDate') || null,
      rating: fd.get('rating') ? Number(fd.get('rating')) : null,
      reviews: Number(fd.get('reviews') || 0),
      inStock: fd.get('inStock') === 'on',
      featured: fd.get('featured') === 'on',
      trending: fd.get('trending') === 'on',
      images: images.map((i) => i.value),
      stock,
    };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    msg.textContent = 'Saving…';
    msg.className = 'text-sm text-muted';
    try {
      const res = await fetch('/api/admin/products', {
        method: slug ? 'PATCH' : 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(collect()),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed');
      location.href = '/admin/products?saved=' + encodeURIComponent(data.slug || slug);
    } catch (e: any) {
      msg.textContent = e.message;
      msg.className = 'text-sm text-sale';
      saveBtn.disabled = false;
    }
  });

  form.querySelector('[data-delete]')?.addEventListener('click', async () => {
    if (!confirm('Delete this product permanently?')) return;
    const res = await fetch('/api/admin/products', {
      method: 'DELETE',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug }),
    });
    if (res.ok) location.href = '/admin/products?deleted=1';
    else { const d = await res.json(); msg.textContent = d.error || 'Delete failed'; msg.className = 'text-sm text-sale'; }
  });

  renderImages();
  renderStock();
</script>
