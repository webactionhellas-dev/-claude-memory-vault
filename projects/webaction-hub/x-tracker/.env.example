# Copy this file to ".env" and fill in the values. Never commit the real .env.

# --- Solana wallet tracking (free) ---
# Get a free key at https://dashboard.helius.dev  ->  create project  ->  copy API key
HELIUS_API_KEY=

# --- X / Twitter tracking ---
# Pick a provider in config.json ("xProvider"): "twitterapi" (cheap) or "official".
#
# twitterapi (recommended, cheap): sign up at https://twitterapi.io, add a few $ of
# credit, copy the API key here. Pay-as-you-go, no monthly minimum.
TWITTERAPI_KEY=
#
# official X API (~$200/mo): bearer token from https://developer.x.com (Basic+).
X_BEARER_TOKEN=

# --- Alerts to your phone via Telegram (free) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here
# 2. Send your new bot any message, then open:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value into TELEGRAM_CHAT_ID
# Leave both blank to run with console + dashboard only (no phone push).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local dashboard ---
DASHBOARD_PORT=8787
