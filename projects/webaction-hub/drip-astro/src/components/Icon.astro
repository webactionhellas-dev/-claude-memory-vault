---
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
  stroke?: number;
}
const { name, size = 20, class: cls = '', stroke = 1.6 } = Astro.props;

const paths = {
  bag: '<path d="M6 7V6a4 4 0 0 1 8 0v1m-9 0h10l.8 11.2a1 1 0 0 1-1 1.05H5.2a1 1 0 0 1-1-1.05L5 7Z"/>',
  search: '<circle cx="9.5" cy="9.5" r="6"/><path d="m20 20-5.2-5.2"/>',
  heart: '<path d="M12 20s-7-4.4-9.2-8.5C1.2 8.2 3 5 6.2 5c2 0 3.2 1.2 3.8 2 .6-.8 1.8-2 3.8-2 3.2 0 5 3.2 3.4 6.5C19 15.6 12 20 12 20Z"/>',
  arrow: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  arrowUpRight: '<path d="M7 17 17 7m0 0H8m9 0v9"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  check: '<path d="m4 12 5 5L20 6"/>',
  star: '<path d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8L3.5 9.7l5.9-.9L12 3Z"/>',
  shield: '<path d="M12 3 5 6v5.5c0 4 3 7 7 8.5 4-1.5 7-4.5 7-8.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  truck: '<path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17.5" cy="17" r="1.6"/>',
  refresh: '<path d="M4 9a8 8 0 0 1 13.6-3.6L20 8M20 4v4h-4"/><path d="M20 15a8 8 0 0 1-13.6 3.6L4 16m0 4v-4h4"/>',
  sliders: '<path d="M4 6h11M19 6h1M4 12h1M9 12h11M4 18h7M15 18h5"/><circle cx="17" cy="6" r="2"/><circle cx="7" cy="12" r="2"/><circle cx="13" cy="18" r="2"/>',
} as const;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={paths[name]}
/>
