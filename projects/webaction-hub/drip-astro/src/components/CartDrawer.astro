---
import Icon from './Icon.astro';
const FREE_SHIP = 250; // € threshold for free worldwide express (Athens is always free)
---

<div data-cart-root class="pointer-events-none invisible fixed inset-0 z-[70] overflow-hidden opacity-0 transition-opacity duration-300">
  <div data-cart-overlay class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <aside
    data-cart-panel
    class="absolute right-0 top-0 flex h-full w-full max-w-[420px] translate-x-full flex-col bg-raised shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
    aria-label="Shopping bag"
  >
    <header class="flex items-center justify-between border-b border-line px-6 py-5">
      <h2 class="flex items-center gap-2 font-display text-xl font-800 tracking-tight">
        <span data-en="Your Bag">Η Τσάντα σας</span> <span data-cart-qty class="text-sm font-500 text-muted"></span>
      </h2>
      <button data-cart-close class="flex h-9 w-9 items-center justify-center rounded-full text-muted hover:text-ink" aria-label="Close bag">
        <Icon name="close" size={20} />
      </button>
    </header>

    <!-- Free shipping progress -->
    <div data-ship-bar class="border-b border-line px-6 py-4">
      <p data-ship-msg class="text-xs text-muted"></p>
      <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-overlay">
        <div data-ship-fill class="h-full rounded-full bg-accent transition-all duration-500" style="width:0%"></div>
      </div>
    </div>

    <div data-cart-lines class="flex-1 overflow-y-auto px-6 py-4"></div>

    <!-- Empty state -->
    <div data-cart-empty class="flex flex-1 flex-col items-center justify-center px-6 text-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-full border border-line text-faint">
        <Icon name="bag" size={28} />
      </span>
      <p class="mt-4 font-display text-lg font-700" data-en="Your bag is empty">Η τσάντα σας είναι άδεια</p>
      <p class="mt-1 text-sm text-muted" data-en="Authenticated grails are waiting.">Πιστοποιημένα grails σας περιμένουν.</p>
      <a href="/shop" data-cart-close class="btn btn-fill mt-6" data-en="Shop sneakers">Δείτε sneakers</a>
    </div>

    <footer data-cart-foot class="border-t border-line px-6 py-5">
      <div class="flex items-center justify-between text-sm">
        <span class="text-muted" data-en="Subtotal">Υποσύνολο</span>
        <span data-cart-subtotal class="font-display text-xl font-800"></span>
      </div>
      <p class="mt-1 text-xs text-faint" data-en="Shipping & taxes calculated at checkout.">Έξοδα αποστολής & φόροι υπολογίζονται στο ταμείο.</p>
      <button data-checkout class="btn btn-accent mt-4 w-full">
        <span data-en="Secure Checkout">Ασφαλής Ολοκλήρωση</span> <Icon name="arrow" size={18} />
      </button>
      <p class="mt-3 flex items-center justify-center gap-1.5 text-[11px] text-faint">
        <Icon name="shield" size={13} /> <span data-en="Encrypted payment · Apple Pay · Klarna">Κρυπτογραφημένη πληρωμή · Apple Pay · Klarna</span>
      </p>
    </footer>
  </aside>
</div>

<script>
  import { getSnapshot, setQty, removeItem, initCart } from '@/lib/cart';
  import { money } from '@/lib/money';

  const FREE_SHIP = 250;
  const root = document.querySelector('[data-cart-root]')!;
  const panel = document.querySelector('[data-cart-panel]')!;
  const linesEl = document.querySelector('[data-cart-lines]')!;
  const emptyEl = document.querySelector('[data-cart-empty]') as HTMLElement;
  const footEl = document.querySelector('[data-cart-foot]') as HTMLElement;
  const shipBar = document.querySelector('[data-ship-bar]') as HTMLElement;

  const open = () => {
    root.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
    requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    panel.classList.add('translate-x-full');
    root.classList.add('opacity-0');
    setTimeout(() => root.classList.add('invisible', 'pointer-events-none'), 320);
    document.body.style.overflow = '';
  };

  window.addEventListener('cart:open', open);
  window.addEventListener('cart:close', close);
  document.querySelectorAll('[data-cart-close]').forEach((b) => b.addEventListener('click', close));
  document.querySelector('[data-cart-overlay]')?.addEventListener('click', close);
  // open drawer briefly when an item is added
  window.addEventListener('cart:added', open);

  function render(snap = getSnapshot()) {
    // header badge
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = String(snap.count);
      el.classList.toggle('hidden', snap.count === 0);
      el.classList.toggle('flex', snap.count > 0);
    });
    document.querySelector('[data-cart-qty]')!.textContent = snap.count ? `· ${snap.count}` : '';

    const hasItems = snap.lines.length > 0;
    emptyEl.style.display = hasItems ? 'none' : 'flex';
    footEl.style.display = hasItems ? 'block' : 'none';
    shipBar.style.display = hasItems ? 'block' : 'none';
    linesEl.style.display = hasItems ? 'block' : 'none';

    if (hasItems) {
      linesEl.innerHTML = snap.lines
        .map(
          (l) => `
        <div class="flex gap-4 border-b border-line py-4 last:border-0">
          <a href="/product/${l.slug}" class="plate h-20 w-20 flex-none overflow-hidden rounded-xl border border-line">
            <img src="${l.image}" alt="" class="h-full w-full object-contain p-1.5" />
          </a>
          <div class="flex flex-1 flex-col">
            <div class="flex justify-between gap-2">
              <div>
                <p class="text-[10px] font-600 uppercase tracking-[0.14em] text-faint">${l.brand}</p>
                <a href="/product/${l.slug}" class="line-clamp-1 text-sm font-500 text-ink hover:text-accent-soft">${l.name}</a>
                <p class="mt-0.5 text-xs text-muted">${(window).__t?.('size') || 'Size'} ${l.size}</p>
              </div>
              <button data-remove="${l.id}" class="h-6 text-faint hover:text-sale" aria-label="Remove">&times;</button>
            </div>
            <div class="mt-auto flex items-center justify-between">
              <div class="flex items-center gap-1 rounded-full border border-line">
                <button data-dec="${l.id}" class="flex h-7 w-7 items-center justify-center text-muted hover:text-ink" aria-label="Decrease">−</button>
                <span class="w-6 text-center text-sm">${l.qty}</span>
                <button data-inc="${l.id}" class="flex h-7 w-7 items-center justify-center text-muted hover:text-ink" aria-label="Increase">+</button>
              </div>
              <span class="text-sm font-700">${money(l.price * l.qty)}</span>
            </div>
          </div>
        </div>`,
        )
        .join('');

      document.querySelector('[data-cart-subtotal]')!.textContent = money(snap.subtotal);

      // free-ship bar
      const remaining = Math.max(0, FREE_SHIP - snap.subtotal);
      const pct = Math.min(100, (snap.subtotal / FREE_SHIP) * 100);
      (document.querySelector('[data-ship-fill]') as HTMLElement).style.width = pct + '%';
      const T = (window as any).__t || ((k: string) => k);
      document.querySelector('[data-ship-msg]')!.innerHTML = remaining
        ? `${T('shipAddPre')} <strong class="text-ink">${money(remaining)}</strong> ${T('shipAddPost')}`
        : `<span class="text-success">${T('shipUnlocked')}</span>`;

      linesEl.querySelectorAll('[data-inc]').forEach((b) =>
        b.addEventListener('click', () => bump(b.getAttribute('data-inc')!, 1)),
      );
      linesEl.querySelectorAll('[data-dec]').forEach((b) =>
        b.addEventListener('click', () => bump(b.getAttribute('data-dec')!, -1)),
      );
      linesEl.querySelectorAll('[data-remove]').forEach((b) =>
        b.addEventListener('click', () => removeItem(b.getAttribute('data-remove')!)),
      );
    }
  }

  function bump(id: string, delta: number) {
    const line = getSnapshot().lines.find((l) => l.id === id);
    if (line) setQty(id, line.qty + delta);
  }

  // Checkout → server creates a Stripe Checkout Session (prices re-computed from
  // the Supabase catalog) and returns its hosted-checkout URL; we redirect there.
  document.querySelector('[data-checkout]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const snap = getSnapshot();
    if (!snap.lines.length) return;
    btn.disabled = true;
    btn.classList.add('opacity-60');
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          lines: snap.lines.map((l) => ({ slug: l.slug, size: l.size, qty: l.qty, image: l.image })),
        }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
        return;
      }
      alert(data.error || 'Checkout is unavailable right now.');
    } catch {
      alert('Could not reach checkout. Please try again.');
    } finally {
      btn.disabled = false;
      btn.classList.remove('opacity-60');
    }
  });

  window.addEventListener('cart:change', (e) => render((e as CustomEvent).detail));
  window.addEventListener('lang:change', () => render());
  initCart();
  render();
</script>
