---
/**
 * Animated gradient backdrop — Astro/CSS adaptation of the React + framer-motion
 * `GradientBackground` component, re-themed to the DRIP palette
 * (tiffany blue / black / white / grey). No JS or framer-motion required:
 * the drift + hue cycle run on pure CSS keyframes, so it's zero-runtime-cost
 * and respects prefers-reduced-motion.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['grad-wrap relative isolate', className]}>
  <div class="grad-bg" aria-hidden="true"></div>
  <slot />
</div>

<style>
  .grad-wrap {
    position: relative;
  }
  /* Drifting tiffany blobs over near-black, with a faint grey wash.
     Subtle on purpose — it should read as luxury depth, not a rainbow. */
  .grad-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(38% 34% at 12% 8%, rgba(0, 192, 182, 0.12), transparent 70%),
      radial-gradient(44% 40% at 88% 26%, rgba(87, 225, 214, 0.08), transparent 72%),
      radial-gradient(46% 42% at 70% 88%, rgba(0, 192, 182, 0.07), transparent 72%),
      radial-gradient(60% 50% at 30% 100%, rgba(150, 150, 160, 0.05), transparent 72%),
      var(--color-base);
    background-size: 200% 200%, 220% 220%, 200% 200%, 240% 240%, 100% 100%;
    background-repeat: no-repeat;
    animation: grad-drift 22s ease-in-out infinite alternate;
  }

  @keyframes grad-drift {
    0% {
      background-position: 0% 0%, 100% 0%, 60% 100%, 20% 100%, 0 0;
    }
    50% {
      background-position: 24% 16%, 74% 22%, 44% 76%, 50% 70%, 0 0;
    }
    100% {
      background-position: 8% 28%, 92% 40%, 70% 90%, 8% 92%, 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .grad-bg {
      animation: none;
    }
  }
</style>
