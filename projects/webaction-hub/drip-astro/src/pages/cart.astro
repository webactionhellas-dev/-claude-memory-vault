---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Your Bag · DRIP" noindex>
  <div class="wrap py-12">
    <h1 class="font-display text-4xl font-900 tracking-tight md:text-5xl" data-en="Your Bag">Η Τσάντα σας</h1>

    <div data-cart-empty class="hidden flex-col items-center justify-center py-24 text-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-full border border-line text-faint">
        <Icon name="bag" size={28} />
      </span>
      <p class="mt-4 font-display text-2xl font-800" data-en="Your bag is empty">Η τσάντα σας είναι άδεια</p>
      <p class="mt-1 text-sm text-muted" data-en="Time to find a grail.">Ώρα να βρείτε ένα grail.</p>
      <a href="/shop" class="btn btn-fill mt-6" data-en="Shop sneakers">Δείτε sneakers</a>
    </div>

    <div data-cart-wrap class="mt-8 hidden gap-10 lg:grid lg:grid-cols-[1fr_360px]">
      <div data-cart-lines class="divide-y divide-line"></div>

      <aside class="h-fit lg:sticky lg:top-28">
        <div class="card-surface p-6">
          <h2 class="font-display text-xl font-800" data-en="Order summary">Σύνοψη παραγγελίας</h2>
          <div class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between text-muted"><span data-en="Subtotal">Υποσύνολο</span><span data-subtotal class="text-ink"></span></div>
            <div class="flex justify-between text-muted"><span data-en="Athens delivery">Παράδοση Αθήνα</span><span class="text-success" data-en="Free">Δωρεάν</span></div>
          </div>
          <div class="mt-4 flex justify-between border-t border-line pt-4 font-display text-lg font-800">
            <span data-en="Total">Σύνολο</span><span data-total></span>
          </div>
          <button data-checkout class="btn btn-accent mt-5 w-full"><span data-en="Secure Checkout">Ασφαλής Ολοκλήρωση</span> <Icon name="arrow" size={18} /></button>
          <a href="/shop" class="mt-3 flex h-10 items-center justify-center text-sm text-muted hover:text-ink" data-en="Continue shopping">Συνέχεια αγορών</a>
          <p class="mt-4 flex items-center justify-center gap-1.5 text-[11px] text-faint">
            <Icon name="shield" size={13} /> <span data-en="Encrypted · Apple Pay · Klarna · Visa">Κρυπτογραφημένο · Apple Pay · Klarna · Visa</span>
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { getSnapshot, setQty, removeItem, initCart } from '@/lib/cart';
  import { money } from '@/lib/money';

  const empty = document.querySelector('[data-cart-empty]') as HTMLElement;
  const wrap = document.querySelector('[data-cart-wrap]') as HTMLElement;
  const linesEl = document.querySelector('[data-cart-lines]')!;

  function render(snap = getSnapshot()) {
    const has = snap.lines.length > 0;
    empty.style.display = has ? 'none' : 'flex';
    wrap.style.display = has ? 'grid' : 'none';
    if (!has) return;

    linesEl.innerHTML = snap.lines
      .map(
        (l) => `
      <div class="flex gap-4 py-5">
        <a href="/product/${l.slug}" class="plate h-24 w-24 flex-none overflow-hidden rounded-xl border border-line">
          <img src="${l.image}" class="h-full w-full object-contain p-2" alt="" />
        </a>
        <div class="flex flex-1 flex-col">
          <div class="flex justify-between">
            <div>
              <p class="text-[10px] font-600 uppercase tracking-[0.14em] text-faint">${l.brand}</p>
              <a href="/product/${l.slug}" class="text-sm font-500 hover:text-accent-soft">${l.name}</a>
              <p class="mt-0.5 text-xs text-muted">${(window).__t?.('size') || 'Size'} ${l.size} (EU)</p>
            </div>
            <span class="text-sm font-700">${money(l.price * l.qty)}</span>
          </div>
          <div class="mt-auto flex items-center justify-between pt-3">
            <div class="flex items-center gap-1 rounded-full border border-line">
              <button data-dec="${l.id}" class="flex h-8 w-8 items-center justify-center text-muted hover:text-ink">−</button>
              <span class="w-7 text-center text-sm">${l.qty}</span>
              <button data-inc="${l.id}" class="flex h-8 w-8 items-center justify-center text-muted hover:text-ink">+</button>
            </div>
            <button data-remove="${l.id}" class="text-xs text-faint hover:text-sale">${(window).__t?.('remove') || 'Remove'}</button>
          </div>
        </div>
      </div>`,
      )
      .join('');

    document.querySelector('[data-subtotal]')!.textContent = money(snap.subtotal);
    document.querySelector('[data-total]')!.textContent = money(snap.subtotal);

    const bump = (id: string, d: number) => {
      const line = getSnapshot().lines.find((x) => x.id === id);
      if (line) setQty(id, line.qty + d);
    };
    linesEl.querySelectorAll('[data-inc]').forEach((b) => b.addEventListener('click', () => bump(b.getAttribute('data-inc')!, 1)));
    linesEl.querySelectorAll('[data-dec]').forEach((b) => b.addEventListener('click', () => bump(b.getAttribute('data-dec')!, -1)));
    linesEl.querySelectorAll('[data-remove]').forEach((b) => b.addEventListener('click', () => removeItem(b.getAttribute('data-remove')!)));
  }

  document.querySelector('[data-checkout]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const s = getSnapshot();
    if (!s.lines.length) return;
    btn.disabled = true;
    btn.classList.add('opacity-60');
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ lines: s.lines.map((l) => ({ slug: l.slug, size: l.size, qty: l.qty, image: l.image })) }),
      });
      const data = await res.json();
      if (data.url) { window.location.href = data.url; return; }
      alert(data.error || 'Checkout is unavailable right now.');
    } catch {
      alert('Could not reach checkout. Please try again.');
    } finally {
      btn.disabled = false;
      btn.classList.remove('opacity-60');
    }
  });

  window.addEventListener('cart:change', (e) => render((e as CustomEvent).detail));
  window.addEventListener('lang:change', () => render());
  initCart();
  render();
</script>
