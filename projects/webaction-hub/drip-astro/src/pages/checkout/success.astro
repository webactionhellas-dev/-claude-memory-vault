---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { supabaseAdmin, adminReady } from '@/lib/supabase-admin';
import { money } from '@/lib/money';

export const prerender = false;

const sessionId = Astro.url.searchParams.get('session_id');
let order: any = null;
let items: any[] = [];
if (sessionId && adminReady()) {
  const { data } = await supabaseAdmin.from('orders').select('*').eq('stripe_session_id', sessionId).maybeSingle();
  order = data;
  if (order) {
    const { data: it } = await supabaseAdmin.from('order_items').select('*').eq('order_id', order.id);
    items = it ?? [];
  }
}
---

<BaseLayout title="Order confirmed · DRIP">
  <section class="wrap min-h-[60vh] py-20">
    <div class="mx-auto max-w-2xl text-center">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-accent/15 text-accent">
        <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <h1 class="font-display text-4xl font-900 tracking-tight text-ink">Thank you.</h1>
      <p class="mt-3 text-muted">
        Your order is in. We're authenticating every pair and you'll get a confirmation email shortly.
      </p>
      {order && (
        <p class="mt-1 text-sm text-faint">
          Order <span class="font-600 text-muted">#{String(order.id).slice(0, 8).toUpperCase()}</span>
          {' · '}{order.status === 'paid' ? 'Paid' : 'Processing'}
        </p>
      )}

      {items.length > 0 && (
        <div class="mt-10 rounded-2xl border border-line p-6 text-left">
          {items.map((it) => (
            <div class="flex items-center justify-between border-b border-line py-3 last:border-0">
              <div>
                <p class="text-[11px] font-600 uppercase tracking-[0.14em] text-faint">{it.brand}</p>
                <p class="text-sm font-500 text-ink">{it.name}</p>
                <p class="text-xs text-muted">Size {it.size} · Qty {it.quantity}</p>
              </div>
              <span class="font-700 text-ink">{money((it.unit_price_cents * it.quantity) / 100)}</span>
            </div>
          ))}
          <div class="flex items-center justify-between pt-4 text-lg font-800 text-ink">
            <span>Total</span>
            <span>{money((order?.total_cents ?? 0) / 100)}</span>
          </div>
        </div>
      )}

      <div class="mt-10 flex items-center justify-center gap-3">
        <a href="/shop" class="btn btn-fill">Continue shopping</a>
        <a href="/" class="btn btn-ghost">Back to home</a>
      </div>
    </div>
  </section>

  <script>
    import { clearCart } from '@/lib/cart';
    clearCart();
  </script>
</BaseLayout>
