# ============================================================================
# CloudSkin custom Stripe checkout, EDGE FUNCTION secrets (PLACEHOLDERS ONLY)
# ----------------------------------------------------------------------------
# NEVER commit real values. Set these with the Supabase CLI at go-live, e.g.
#   supabase secrets set --project-ref ocszztflphqsaoyhlerx STRIPE_SECRET_KEY=sk_test_...
# or paste rows into the existing public.app_secrets table (service-role-only);
# the functions read Deno.env first, then app_secrets (same pattern as the
# cloudskin-order-webhook already in this project).
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase into every edge function; do NOT set them yourself.
# ============================================================================

# ---- REQUIRED before checkout can go live (from Mike / the owner) ----
STRIPE_SECRET_KEY=sk_test_xxx            # server-side ONLY, never shipped to the browser
STRIPE_WEBHOOK_SECRET=whsec_xxx          # from `stripe listen` (test) or the Dashboard endpoint (live)

# ---- REQUIRED in the browser bundle (public, safe) ----
# STRIPE_PUBLISHABLE_KEY (pk_test_/pk_live_) is only needed if you later switch
# to the embedded Payment Element. The redirect Checkout Session flow does NOT
# need it in the browser. Documented here so it is not forgotten.
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- OPTIONAL: Shopify fulfilment sync (order lands in Shopify after payment) ----
# Missing token => the webhook still records the paid order (no sale lost) and
# marks shopify_sync_status='skipped'. Needs Admin API scope write_orders.
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_STORE_DOMAIN=rta3sf-47.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=54674b6ccdc6cdd3817ee38afd8db4aa   # public token (already client-side)
SHOPIFY_API_VERSION=2025-01

# ---- Presentment / currency (Goal A) ----
# adaptive  = Stripe Adaptive Pricing owns FX (RECOMMENDED default, no FX math here)
# manual    = session currency = customer's selected currency, converted via FX seam
CHECKOUT_PRESENTMENT_MODE=adaptive
STORE_BASE_CURRENCY=eur                    # switch to 'aed' when the store base moves
# Only used in manual mode:
FX_RATES_URL=                              # optional live EUR-referenced rates JSON; blank => static fallback
FX_FEE_BPS=0                               # optional owner-set FX buffer in basis points (0 = off)

# ---- DDP (Goal B) ----
DUTIES_INCLUDED=true                       # prices are duties-inclusive (owner-set)
# Per-product country of manufacture for the customs label (PENDING from owner).
# JSON map of Shopify handle -> ISO country code. A Shopify metafield source can
# replace this later (see supabase/README.md).
COUNTRY_OF_ORIGIN_MAP={}

# ---- URLs / CORS ----
SITE_URL=https://www.cloudskin.com
ALLOWED_ORIGINS=https://www.cloudskin.com,https://cloudskin.com,http://localhost:8080
# CHECKOUT_SUCCESS_URL / CHECKOUT_CANCEL_URL override the defaults if needed.
