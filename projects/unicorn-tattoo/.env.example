# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://unicorntattoo.gr

# ── Booking form email (API route) ──────────────────────
# Using Resend (https://resend.com), swap for your provider of choice.
RESEND_API_KEY=
BOOKING_TO_EMAIL=unicorntattoo2001@gmail.com
BOOKING_FROM_EMAIL=bookings@unicorntattoo.gr

# ── Instagram feed (@unicorn.tattoo) via Behold ─────────
# Free, no-scrape live feed. Create one at https://behold.so, connect the
# Instagram account, copy the Feed ID here. Blank = studio-photo fallback grid.
BEHOLD_FEED_ID=

# ── Supabase CMS (project: unicorn-tattoo) ──────────────
# Public values only. NEVER put a service_role key in this project:
# the whole CMS runs on the anon key + RLS + the single owner login.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── /admin owner login (documentation only) ─────────────
# The app never reads these; they are the credentials record for the owner
# account created in Supabase Auth. Change the password after first login.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
