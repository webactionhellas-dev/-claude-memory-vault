{
  "name": "web-action-commerce-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Web Action commerce starter. Astro + Supabase + Stripe storefront (catalog, cart, Stripe checkout, admin, per-size inventory). De-branded template.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test \"tests/**/*.test.ts\"",
    "seed": "node scripts/seed-products.mjs && node scripts/seed-inventory.mjs",
    "create-owner": "node scripts/create-owner.mjs",
    "audit:security": "python scripts/security_audit.py ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/vercel": "^11.0.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "astro": "^7.0.7",
    "sharp": "^0.34.1",
    "stripe": "^22.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
