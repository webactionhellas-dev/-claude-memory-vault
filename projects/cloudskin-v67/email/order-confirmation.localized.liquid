<!-- ============================================================================
     CLOUDSKIN - Shopify "{{ t_label_order }} confirmation" customer notification (Liquid)
     ----------------------------------------------------------------------------
     APPLY (Shopify admin, needs access):
       Settings > Notifications > Customer notifications > {{ t_label_order }} confirmation >
       Edit code > click inside the code editor > Ctrl+A (select all) > Delete >
       paste this ENTIRE file > Save > "Send test".
       The editor is CodeMirror 6, so paste reliably by copying the whole file to
       the clipboard first, then Ctrl+A + Ctrl+V inside the editor.

     WHAT IT FIXES (vs the live re-skinned default):
       - THE BLANK PRODUCT IMAGE. Several CLOUDSKIN products carry NO image in
         Shopify (Form Bra, Ace Dress, Performance Shorts), so the default
         template falls back to Shopify's grey "no-image.png" placeholder = the
         broken picture Mike saw. This template pulls the REAL product photo from
         the site itself, https://www.cloudskin.com/img/shopify/<handle>-1.jpg,
         which is the exact photo shown on the website product cards, is public
         (the store gate is client-side JS on HTML pages only, static /img assets
         are always reachable), and is verified 200 for every catalogue product.
         Fallbacks: Shopify media if a non-catalogue product has it, else a
         tasteful oat monogram tile. It is NEVER a broken icon.
       - GMAIL DARK MODE. Explicit background + text colours on every cell, bgcolor
         attributes, and a prefers-color-scheme dark block, so it stays readable
         and on-brand in Gmail (desktop + mobile) and Apple / iOS Mail dark mode.
       - The double currency label. Everything uses `| money` (not
         `| money_with_currency`), so no more "Dhs. 357.00 AED" next to
         "Dhs. 357.00". Follows the store money format (Dhs. today, AED after the
         pending toggle) automatically.
       - {{ t_label_payment }} reads "{{ t_label_card }}" / "PayPal" (customer-facing), never a gateway label.
       - "{{ t_cta_view{{ t_label_order }} }}" points at {{ order.order_status_url }} (never 404s;
         shows live tracking once it exists).
       - No em-dashes (house rule).
     ============================================================================ -->
{%- assign lang = attributes.lang | default: 'en' -%}
{%- case lang -%}
{%- when 'el' -%}{%- assign t_order_trackingBody = "Ο σύνδεσμος παρακολούθησης ενεργοποιείται εντός 24 ωρών από την αποστολή. Θα σας τον στείλουμε με email μόλις η παραγγελία σας ξεκινήσει το ταξίδι της προς εσάς, και μπορείτε να την παρακολουθείτε όποτε θέλετε από το κουμπί παρακάτω." -%}{%- assign t_order_intro = "Με μεγάλη χαρά σας καλωσορίζουμε στην CLOUDSKIN. Λάβαμε την παραγγελία σας και την ετοιμάζουμε με φροντίδα." -%}{%- assign t_footer_tagline = "Αθλητική ένδυση πολυτελείας. Τένις, πάντελ, στούντιο." -%}{%- assign t_order_title = "Η παραγγελία σας επιβεβαιώθηκε." -%}{%- assign t_order_trackingTitle = "Παρακολούθηση της παραγγελίας σας" -%}{%- assign t_cta_viewOrder = "Δείτε την παραγγελία σας" -%}{%- assign t_value_complimentary = "Δωρεάν" -%}{%- assign t_label_shipTo = "Αποστολή προς" -%}{%- assign t_order_thankYouPlain = "Σας ευχαριστούμε." -%}{%- assign t_label_quantity = "Ποσότητα" -%}{%- assign t_label_subtotal = "Υποσύνολο" -%}{%- assign t_label_shipping = "Αποστολή" -%}{%- assign t_label_discount = "Έκπτωση" -%}{%- assign t_label_payment = "Πληρωμή" -%}{%- assign t_label_order = "Παραγγελία" -%}{%- assign t_footer_city = "Ντουμπάι" -%}{%- assign t_label_total = "Σύνολο" -%}{%- assign t_label_card = "Κάρτα" -%}
