<!-- ============================================================================
     CLOUDSKIN - Shopify "Shipping confirmation" customer notification (Liquid)
     ----------------------------------------------------------------------------
     APPLY (Shopify admin, needs access):
       Settings > Notifications > Customer notifications > Shipping confirmation >
       Edit code > click inside the code editor > Ctrl+A (select all) > Delete >
       paste this ENTIRE file > Save > "Send test".
       CodeMirror 6 editor: copy the whole file to the clipboard, then
       Ctrl+A + Ctrl+V inside the editor.

     SENT WHEN: an order is fulfilled / dispatched (a fulfillment is created).

     WHAT IT DOES:
       - Premium editorial look, a sibling of the Order confirmation email (same
         shell, palette, wordmark, hairline, footer, Gmail dark-mode hardening).
       - Puts tracking front and centre: carrier + tracking number + a big
         "Track your order" button to {{ fulfillment.tracking_url }}, falling back
         to {{ order.order_status_url }} if the carrier link is not attached yet.
       - Lists the items IN THIS SHIPMENT with the REAL product photo pulled from
         the site (https://www.cloudskin.com/img/shopify/<handle>-1.jpg), the same
         fix as the Order confirmation, so it is never a broken image icon.
       - No prices (a shipping note is not a receipt). Money stays in the receipt.
       - No em-dashes (house rule).
     ============================================================================ -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ shop.name }} shipping {{ order.name }}</title>
<style>
  :root { color-scheme: light; supported-color-schemes: light; }
  body { margin:0; padding:0; width:100%; background:#efeae1; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
  img { border:0; line-height:100%; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }
  table { border-collapse:collapse; mso-table-lspace:0; mso-table-rspace:0; }
  a { color:#171512; }
  .cs-link { color:#171512; }
  @media only screen and (max-width:600px){
    .cs-shell { width:100% !important; }
    .cs-pad { padding-left:24px !important; padding-right:24px !important; }
  }
  /* Cream only (Mike's call): no dark-mode palette. color-scheme:light above + explicit
     cream bgcolor on every cell keep Gmail/Apple Mail from inverting the background to black. */
</style>
</head>
<body style="margin:0;padding:0;background:#efeae1;">
  <!-- preheader (hidden) -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;opacity:0;color:#efeae1;font-size:1px;line-height:1px;">
    Your CLOUDSKIN order {{ order.name }} is on its way.
  </div>

  {% assign track_url = order.order_status_url %}
  {% if fulfillment.tracking_url %}{% assign track_url = fulfillment.tracking_url %}{% endif %}

  <table role="presentation" class="cs-page" width="100%" cellpadding="0" cellspacing="0" bgcolor="#efeae1" style="background:#efeae1;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="600" class="cs-shell cs-card" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="width:600px;max-width:600px;background:#ffffff;border:1px solid #e6e0d6;">

          <!-- Wordmark -->
          <tr>
            <td class="cs-pad" align="center" style="padding:44px 48px 0;">
              <div class="cs-wordmark" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;letter-spacing:.42em;color:#171512;font-weight:600;text-transform:uppercase;">CLOUDSKIN</div>
              <div class="cs-rule" style="height:1px;line-height:1px;font-size:0;background:#e6e0d6;margin:28px 0 0;">&nbsp;</div>
            </td>
          </tr>

          <!-- Headline -->
          <tr>
            <td class="cs-pad" align="center" style="padding:34px 48px 0;">
              <div class="cs-muted" style="font-size:10.5px;letter-spacing:.28em;text-transform:uppercase;color:#857d72;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">Order {{ order.name }}</div>
              <div class="cs-ink" style="font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:30px;line-height:1.22;color:#171512;margin:12px 0 0;">Your order is on its way.</div>
              <p class="cs-soft" style="margin:16px 0 0;font-size:15px;line-height:1.75;color:#55504a;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                {% if order.customer.first_name %}{{ order.customer.first_name }}, your{% else %}Your{% endif %} CLOUDSKIN order has been dispatched and is making its way to you. Follow every step with the tracking below.
              </p>
            </td>
          </tr>

          <!-- Tracking (the hero) -->
          <tr>
            <td class="cs-pad" style="padding:34px 48px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="cs-callout" bgcolor="#efeae1" style="border:1px solid #d8d0c3;background:#efeae1;padding:22px 24px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                    <div class="cs-muted" style="font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:#857d72;">Carrier</div>
                    <div class="cs-ink" style="font-size:15px;color:#171512;font-weight:600;margin:6px 0 0;">{% if fulfillment.tracking_company %}{{ fulfillment.tracking_company }}{% else %}DHL Express{% endif %}</div>
                    {% if fulfillment.tracking_number %}
                    <div class="cs-muted" style="font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:#857d72;margin:16px 0 0;">Tracking number</div>
                    <div class="cs-ink" style="font-size:15px;color:#171512;margin:6px 0 0;letter-spacing:.04em;">{{ fulfillment.tracking_number }}</div>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Track button -->
          <tr>
            <td class="cs-pad" align="center" style="padding:26px 48px 0;">
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
                <tr>
                  <td class="cs-btn" bgcolor="#171512" align="center" style="background:#171512;">
                    <a class="cs-btn" href="{{ track_url }}" style="display:inline-block;background:#171512;color:#ffffff;text-decoration:none;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;padding:16px 44px;">Track your order</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Grace note -->
          <tr>
            <td class="cs-pad" align="center" style="padding:20px 48px 0;">
              <p class="cs-muted" style="margin:0;font-size:12.5px;line-height:1.7;color:#857d72;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                Your first tracking scan can take a few hours to appear after dispatch. If the link looks quiet at first, it will update soon.
              </p>
            </td>
          </tr>

          <!-- Items in this shipment -->
          <tr>
            <td class="cs-pad" style="padding:30px 48px 0;">
              <div class="cs-muted" style="font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:#857d72;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">In this shipment</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0 0;">
                {% for line in fulfillment.fulfillment_line_items %}
                {% assign li = line.line_item %}
                <tr>
                  <td width="72" valign="top" style="padding:0 16px 22px 0;">
                    {%- assign ph = li.product.handle -%}
                    {%- assign pfx = ph | slice: 0, 4 -%}
                    {%- if pfx == 'the-' -%}
                      <img src="https://www.cloudskin.com/img/shopify/{{ ph }}-1.jpg" width="72" height="72" alt="{{ li.title | escape }}" class="cs-tileborder" style="display:block;width:72px;height:72px;object-fit:cover;border:1px solid #e6e0d6;background:#efeae1;">
                    {%- elsif li.image -%}
                      <img src="{{ li | img_url: '160x160', crop: 'center' }}" width="72" height="72" alt="{{ li.title | escape }}" class="cs-tileborder" style="display:block;width:72px;height:72px;object-fit:cover;border:1px solid #e6e0d6;background:#efeae1;">
                    {%- else -%}
                      <table role="presentation" width="72" height="72" cellpadding="0" cellspacing="0" style="width:72px;height:72px;"><tr><td class="cs-tile cs-tileborder" align="center" valign="middle" bgcolor="#efeae1" style="width:72px;height:72px;background:#efeae1;border:1px solid #e6e0d6;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;letter-spacing:.22em;color:#171512;font-weight:600;">CS</td></tr></table>
                    {%- endif -%}
                  </td>
                  <td valign="top" style="padding:0 0 22px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                    <div class="cs-ink" style="font-size:14.5px;color:#171512;font-weight:600;line-height:1.4;">{{ li.title }}</div>
                    {% if li.variant.title and li.variant.title != 'Default Title' %}
                      <div class="cs-muted" style="font-size:12.5px;color:#857d72;margin:5px 0 0;">{{ li.variant.title }}</div>
                    {% endif %}
                    <div class="cs-muted" style="font-size:12.5px;color:#857d72;margin:5px 0 0;">Quantity {{ line.quantity }}</div>
                  </td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>

          <!-- Delivering to -->
          {% if order.shipping_address %}
          <tr>
            <td class="cs-pad" style="padding:22px 48px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
              <div class="cs-muted" style="font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:#857d72;">Delivering to</div>
              <div class="cs-ink" style="font-size:13.5px;color:#171512;line-height:1.65;margin:6px 0 0;">
                {{ order.shipping_address.name }}<br>
                {{ order.shipping_address.address1 }}{% if order.shipping_address.address2 != blank %}, {{ order.shipping_address.address2 }}{% endif %}<br>
                {{ order.shipping_address.city }}{% if order.shipping_address.province != blank %}, {{ order.shipping_address.province }}{% endif %} {{ order.shipping_address.zip }}<br>
                {{ order.shipping_address.country }}
              </div>
            </td>
          </tr>
          {% endif %}

          <!-- Help -->
          <tr>
            <td class="cs-pad" align="center" style="padding:24px 48px 0;">
              <p class="cs-muted" style="margin:0;font-size:12.5px;line-height:1.7;color:#857d72;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
                Questions about your order? We are here to help at <a class="cs-link" href="mailto:info@cloudskin.com" style="color:#171512;text-decoration:underline;">info@cloudskin.com</a>.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td class="cs-pad" align="center" style="padding:36px 48px 46px;">
              <div class="cs-rule" style="height:1px;line-height:1px;font-size:0;background:#e6e0d6;margin:0 0 22px;">&nbsp;</div>
              <div class="cs-muted" style="font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:#857d72;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">CLOUDSKIN &middot; Dubai</div>
              <div class="cs-muted" style="margin:8px 0 0;font-size:11px;line-height:1.6;color:#a59d90;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">Luxury activewear. Tennis, padel, studio.</div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
